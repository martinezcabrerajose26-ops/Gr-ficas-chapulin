	column 'Mes Año'
		lineageTag: 9f97fbc7-84bf-4f1d-a281-c79e38688bf2
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mes Año]

		annotation SummarizationSetBy = Automatic

	partition 'Calendario CEA' = calculated
		mode: import
		source =
				
				VAR FechaMinima =
				    MINX(
				        UNION(
				            SELECTCOLUMNS('CEA', "Fecha", 'CEA'[FechaPago]),
				            SELECTCOLUMNS('CEA', "Fecha", 'CEA'[CEA Fecha Recibo])
				        ),
				        [Fecha]
				    )
				VAR FechaMaxima =
				    MAXX(
				        UNION(
				            SELECTCOLUMNS('CEA', "Fecha", 'CEA'[FechaPago]),
				            SELECTCOLUMNS('CEA', "Fecha", 'CEA'[CEA Fecha Recibo])
				        ),
				        [Fecha]
				    )
				RETURN
				ADDCOLUMNS(
				    CALENDAR(FechaMinima, FechaMaxima),
				    "Año", YEAR([Date]),
				    "Mes Número", MONTH([Date]),
				    "Mes Nombre", FORMAT([Date], "MMMM"),
				    "Mes Año", FORMAT([Date], "MMM yyyy")
				)

	annotation PBI_Id = 851662b7e4f347a8bbcf42b066ea76f3

