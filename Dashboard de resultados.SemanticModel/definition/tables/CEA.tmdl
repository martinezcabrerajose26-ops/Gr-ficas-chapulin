table CEA
	lineageTag: b9be631b-551d-41b8-8b9b-5d8e3f8a90c8

	measure 'CEA Total Pagado' = SUM('CEA'[Monto])
		formatString: \$#,0.###############;-\$#,0.###############;\$#,0.###############
		lineageTag: 9bcb9402-ac30-448d-851c-4aba1658ae98

		annotation PBI_FormatHint = {"currencyCulture":"es-MX"}

	measure 'CEA Cantidad de Pagos' = COUNTROWS('CEA')
		formatString: 0
		lineageTag: 84fb0f8c-2bd5-4726-828f-3e99a5a82477

	measure 'CEA Promedio Mensual' =
			
			AVERAGEX(
			    VALUES('CEA'[CEA Mes Número]),
			    [CEA Total Pagado]
			)
		formatString: \$#,0.###############;-\$#,0.###############;\$#,0.###############
		lineageTag: fa37da43-e05c-4206-a2e3-c48e1db3fd19

		annotation PBI_FormatHint = {"currencyCulture":"es-MX"}

	measure 'CEA Monto Pagado' =
			
			SUM('CEA'[Monto])
		formatString: \$#,0.###############;-\$#,0.###############;\$#,0.###############
		lineageTag: 05b2511d-4baf-4f51-acc0-3f19f1f71bb2

		annotation PBI_FormatHint = {"currencyCulture":"es-MX"}

	measure 'CEA Monto Correspondiente' =
			
			CALCULATE(
			    SUM('CEA'[Monto]),
			    USERELATIONSHIP(
			        'Calendario CEA'[Date],
			        'CEA'[CEA Fecha Recibo]
			    )
			)
		formatString: \$#,0.###############;-\$#,0.###############;\$#,0.###############
		lineageTag: 39aa0c2f-5f64-4ed0-a172-6f96d2de22c0

		annotation PBI_FormatHint = {"currencyCulture":"es-MX"}

